{
  "name": "salonops-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && . .venv/bin/activate && PYTHONPATH=. uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "cd backend && . .venv/bin/activate && PYTHONPATH=. pytest",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
